# HaCha Backend Gateway - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Application environment
NODE_ENV=development

# HTTP server port
PORT=3000

# Chrome extension origin for CORS
# Get this from chrome://extensions after loading the unpacked extension
EXTENSION_ORIGIN=chrome-extension://*
CORS_ORIGIN=chrome-extension://*

# Maximum claim length (characters)
MAX_CLAIM_LENGTH=5000

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# --- Future phases (not used in Phase 4) ---
# Redis cache
REDIS_URL=redis://localhost:6379

# MongoDB persistence
MONGODB_URI=mongodb://localhost:27017/hacha

# Python AI microservice
AI_SERVICE_URL=http://localhost:8000