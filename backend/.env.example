# HaCha Backend Gateway - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Application environment
NODE_ENV=development

# HTTP server port
PORT=3000

# Chrome extension origin for CORS
# Get this from chrome://extensions after loading the unpacked extension
EXTENSION_ORIGIN=chrome-extension://*
CORS_ORIGIN=chrome-extension://*

# Maximum claim length (characters)
MAX_CLAIM_LENGTH=5000

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Redis cache (Phase 6)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400
CACHE_KEY_PREFIX=hacha:claim
CACHE_SCHEMA_VERSION=v1
CACHE_ENABLED=true
CACHE_CONNECT_TIMEOUT_MS=5000
CACHE_COMMAND_TIMEOUT_MS=2000
CACHE_MAX_RETRIES=3

# Google Fact Check Tools API (Phase 7)
# Get API key from Google Cloud Console: https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACTCHECK_API_KEY=
FACTCHECK_ENABLED=true
FACTCHECK_LANGUAGE=en
FACTCHECK_PAGE_SIZE=10
FACTCHECK_MAX_AGE_DAYS=
FACTCHECK_TIMEOUT_MS=5000
FACTCHECK_NO_MATCH_TTL_SECONDS=900

# MongoDB persistence (Phase 8+)
MONGODB_URI=mongodb://localhost:27017/hacha

# Python AI microservice (Phase 9+)
AI_SERVICE_URL=http://localhost:8000